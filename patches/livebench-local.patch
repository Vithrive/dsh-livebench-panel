+def blamed_api_kwarg(exc: BaseException, request_kwargs: dict[str, Any]) -> str | None:
+    """Return the sent parameter a 4xx error blames, else None.
+
+    Only 400/422 count. Attribution requires the parameter name and a rejection cue
+    to sit inside the same short window, so a value error such as
+    "max_tokens: 32000 is greater than the model maximum" is not mistaken for
+    "max_tokens is unsupported" (which would silently drop the length cap).
+    """
+    status = _error_status_code(exc)
+    if status not in _PARAM_COMPAT_STATUSES:
+        return None
+    text = _error_text(exc).lower()
+    candidates = [k for k in request_kwargs if k not in _PARAM_COMPAT_PROTECTED]
+    if not candidates:
+        return None
+    # 1) 被引号包裹的参数名是最可靠的信号：
+    #    "`temperature` is deprecated" / "'top_p' is not supported"
+    quoted = [n for n in candidates if any(f'{q}{n.lower()}{q}' in text for q in ('`', "'", '"'))]
+    if quoted:
+        return max(quoted, key=len)
+    # 2) 裸词：要求参数名与拒绝措辞落在同一窗口内（取最长匹配避免误伤）
+    hits: list[str] = []
+    for name in candidates:
+        low = name.lower()
+        start = text.find(low)
+        while start >= 0:
+            window = text[max(0, start - _PARAM_CUE_WINDOW): start + len(low) + _PARAM_CUE_WINDOW]
+            if any(cue in window for cue in _PARAM_REJECTION_CUES):
+                hits.append(name)
+                break
+            start = text.find(low, start + len(low))
+    return max(hits, key=len) if hits else None
