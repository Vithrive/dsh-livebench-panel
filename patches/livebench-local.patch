+def _is_transient(exc: BaseException) -> bool:
+    """重试可能成功的错误。4xx（除 408/409/425/429）是客户端错误，重试无意义。"""
+    status = _error_status_code(exc)
+    if status is not None:
+        if status in _TRANSIENT_STATUSES:
+            return True
+        if 400 <= status < 500:
+            return False
+    text = _error_text(exc).lower()
+    return any(k in text for k in _POOL_ERROR_KEYS + _TRANSIENT_ERROR_KEYS)
