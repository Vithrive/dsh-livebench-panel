+def warm_process_pool():
+    """dsh-livebench-panel patch: on Windows (spawn), the first
+    ProcessPoolExecutor created from a non-main thread can hit the
+    'bootstrapping phase' race and break every evaluation. Warm the pool once
+    at process start so later per-question pools are stable."""
+    global _pool_warmed
