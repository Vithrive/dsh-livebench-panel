+def _arg_set(args, kwargs, name, index, value):
+    """Write a call argument back in whichever form the caller used."""
+    if name in kwargs:
+        kwargs[name] = value
+        return args
+    if len(args) > index:
+        args = list(args)
+        args[index] = value
+    return args
